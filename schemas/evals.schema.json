{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Behavioral evaluation cases and human review record",
  "required": [
    "schema_version",
    "skill",
    "review",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "skill": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "evidence": {
          "type": "string",
          "maxLength": 10000
        },
        "payload_sha256": {
          "type": "string",
          "pattern": "^(?:|[0-9a-f]{64})$"
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "prompt",
          "should_trigger",
          "expected_behaviors"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "prompt": {
            "type": "string",
            "minLength": 10,
            "maxLength": 20000
          },
          "should_trigger": {
            "type": "boolean"
          },
          "expected_behaviors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 5,
              "maxLength": 5000
            }
          }
        }
      }
    }
  }
}
