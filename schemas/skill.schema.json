{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "title": "Per-skill operational contract (not an Agent Skills standard field)",
  "required": [
    "schema_version",
    "name",
    "display_name",
    "status",
    "entrypoints",
    "smoke_tests"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[^\\r\\n|]+$"
    },
    "status": {
      "enum": [
        "draft",
        "active"
      ]
    },
    "entrypoints": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^scripts/[^\\\\\\s]+\\.(py|mjs|js|cjs|sh)$"
      }
    },
    "smoke_tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "timeout_seconds",
          "expected_exit"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "command": {
            "type": "array",
            "minItems": 2,
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 120
          },
          "expected_exit": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "stdout_contains": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20000
          }
        }
      }
    }
  }
}
