{
  "_note": "Optional conventions; the repository is canonical. No fixed providers. Not native harness configuration.",
  "schema_version": 2,
  "sources": {
    "work": {
      "locator": "<reference-discovered-in-repository>",
      "authority": [
        "priority",
        "progress"
      ],
      "access_ref": "<existing-script-skill-or-tool>"
    },
    "requirements": {
      "locator": "<approved-source>",
      "authority": [
        "acceptance"
      ]
    }
  },
  "delivery": {
    "strategy": "local",
    "merge": "explicit-authorization-only"
  },
  "execution": {
    "max_writers": 1,
    "model_policy": "subagents-v2"
  },
  "state": {
    "profile": ".orquestrar/profile.json",
    "overrides": ".orquestrar/overrides.json"
  }
}
